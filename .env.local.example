# 로컬 개발용 환경 변수 예시
# 이 파일을 복사해서 .env.local 로 사용하고 실제 값을 채우세요.
#   cp .env.local.example .env.local

# === Supabase ===
# 클라이언트 노출 OK (NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 앱 공개 URL — OAuth redirect 구성에 사용(미설정 시 로컬 기본값 http://127.0.0.1:3000).
# 운영 배포 시 배포 도메인으로 설정.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# === Claude API (Anthropic) ===
# 서버 전용
ANTHROPIC_API_KEY=

# === 네이버 책 검색 API (옵션 — 대안: Google Books) ===
# 서버 전용
NAVER_BOOK_CLIENT_ID=
NAVER_BOOK_CLIENT_SECRET=

# === Google OAuth (로컬 Supabase Auth) ===
# Google Cloud Console > OAuth 2.0 클라이언트(웹)에서 발급.
# 로컬 Supabase(supabase start)가 config.toml 의 env() 치환으로 읽는다 → 값 변경 후 supabase 재시작 필요.
# Google 승인된 리디렉션 URI 에 로컬 콜백 등록: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# === 환경 구분 ===
# 로컬 개발은 development 가 기본
NODE_ENV=development
